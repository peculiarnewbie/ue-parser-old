{
  "name": "@ue-shed/utrace-parser-wasm",
  "version": "0.2.0",
  "description": "Browser WebAssembly parser for Unreal Engine UTrace captures",
  "homepage": "https://github.com/ue-shed/ue-shed-utrace#readme",
  "bugs": {
    "url": "https://github.com/ue-shed/ue-shed-utrace/issues"
  },
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ue-shed/ue-shed-utrace.git",
    "directory": "packages/utrace-parser-wasm"
  },
  "keywords": [
    "unreal-engine",
    "utrace",
    "wasm",
    "webassembly",
    "parser",
    "profiling"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./manifest": {
      "types": "./dist/manifest.d.ts",
      "import": "./dist/manifest.js",
      "default": "./dist/manifest.js"
    },
    "./parser-manifest.json": "./dist/parser-manifest.json",
    "./worker": {
      "types": "./dist/worker.d.ts",
      "import": "./dist/worker.js",
      "default": "./dist/worker.js"
    }
  },
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "check": "node ./scripts/check-package.mjs",
    "prepack": "node ./scripts/prepack.mjs"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "packageManager": "pnpm@11.20.0"
}
